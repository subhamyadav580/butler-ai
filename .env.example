# Copy to .env and fill in. Never commit .env.

# --- LLM ---
OPENAI_API_KEY=
# Optional; gpt-4.1-mini follows multi-step tool flows (e.g. Swiggy cart) more reliably
OPENAI_MODEL=gpt-4o-mini

# --- Gmail ---
# Allow replying/sending/drafts by default (the Gmail card's switch overrides it).
# Every reply or new email still waits for your Approve.
GMAIL_ALLOW_SEND=false

# --- Web search ---
# Get a key at https://serper.dev (Google results). Leave empty to disable web search.
SERPER_API_KEY=
# Get a key at https://tavily.com (search built for AI, with its own answer)
TAVILY_API_KEY=
# Tavily depth: basic (1 credit) or advanced (2 credits, more relevant)
TAVILY_SEARCH_DEPTH=basic
# Get a key at https://firecrawl.dev (web and news search; 2 credits per search)
FIRECRAWL_API_KEY=
# Which provider to use first: serper, tavily or firecrawl. Empty = the first one with a key.
# Any other configured provider is used as a fallback if the first fails.
WEB_SEARCH_PROVIDER=
# Default country for results, 2-letter code (in, us, gb…). Empty = provider default.
WEB_SEARCH_COUNTRY=

# --- Swiggy ---
# Services to load: any of food, instamart, dineout (fewer = fewer tools for the model)
SWIGGY_SERVICES=food,instamart,dineout

# --- Telegram (only for `python -m butler telegram`) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot. Empty = NOBODY can use it.
# Send /start to your bot to see your ID.
TELEGRAM_ALLOWED_USER_IDS=
# Restrict Swiggy (which acts on YOUR account) to one user id. Empty = all allowed users.
TELEGRAM_OWNER_ID=

# --- Web UI (only for `python -m butler web`) ---
# 127.0.0.1 = only this machine can open the UI. Use 0.0.0.0 to expose it,
# and then ALWAYS set a password.
BUTLER_WEB_HOST=127.0.0.1
BUTLER_WEB_PORT=8000
BUTLER_WEB_PASSWORD=

# --- Time zone ---
# IANA name (e.g. Asia/Kolkata). Empty = this computer's time zone.
# BUTLER_TIMEZONE=

# --- Optional paths ---
# Web UI chat list + transcripts (SQLite)
# BUTLER_DATA_DIR=./data
# BUTLER_DATABASE_PATH=./data/butler.db
# BUTLER_SECRETS_DIR=./secrets
# GOOGLE_CLIENT_SECRET_FILE=./secrets/google_client_secret.json
